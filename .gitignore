# Dependencies
node_modules/
plugin/node_modules/

# Package-manager logs and local caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# TypeScript and bundler caches
*.tsbuildinfo
.cache/
.eslintcache

# Test and coverage output
coverage/
.nyc_output/

# Local environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Operating-system and editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Obsidian vault state when a vault is used for local testing
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.trash/
